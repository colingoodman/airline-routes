[Unit]
Description=Capture the fixed free Avinor schedule research sample
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=airplanes-refresh
Group=airplanes-refresh
WorkingDirectory=/opt/airplanes-refresh/repo
ExecStart=/opt/airplanes-refresh/repo/.venv/bin/python scripts/schedule_research.py --work /var/lib/airplanes-schedule-research --airports OSL BNN --hours 168 --max-requests 24 --max-disk-mib 256
StateDirectory=airplanes-schedule-research
TimeoutStartSec=150
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/airplanes-schedule-research
UMask=0077
