[Unit]
Description=Collect and validate an airline map refresh candidate
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=airplanes-refresh
Group=airplanes-refresh
WorkingDirectory=/opt/airplanes-refresh/repo
ExecStart=/opt/airplanes-refresh/repo/.venv/bin/python scripts/refresh_runner.py --state /var/lib/airplanes-refresh --max-seconds 5400 --max-disk-mib 1024 --retain 3 --daily-after-utc 03:00
StateDirectoryMode=0700
StateDirectory=airplanes-refresh
TimeoutStartSec=5500
KillMode=control-group
MemoryHigh=128M
MemoryMax=160M
MemorySwapMax=768M
CPUQuota=50%
Nice=10
IOSchedulingClass=idle
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=true
CapabilityBoundingSet=
RestrictSUIDSGID=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/airplanes-refresh
UMask=0077
